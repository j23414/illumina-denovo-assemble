params {
  help = false

  // Output directory
  outdir = './assemble-results'

  // Either input reads as a samplesheet (csv) with headings "sample","R1","R2" or a glob pattern
  samplesheet = false
  reads = false

  // TODO, --method spades,xxx,xxx,xxx


  // SPADES args
  spades_args = false
  error_strategy='ignore' // 'ignore' or 'terminate'

  kraken_db = false
}

profiles {
  local { }
  stjude {
    includeConfig 'configs/stjude.config'
  }
  docker {
    docker.enabled = true
    singularity.enabled = false
    apptainer.enabled = false
    podman.enabled = false
    shifter.enabled = false
    charliecloud.enabled = false
  }
  conda {
    conda.enabled = true
  }
}

process {
  publishDir = [ path: "${params.outdir}", mode: 'copy']
  errorStrategy = params.error_strategy
  withName: 'SPADES'       {
    publishDir = [ path: "${params.outdir}/spades", mode: 'copy']
    ext.args = params.spades_args ?: [
    //'--isolate', // high coverage isolate or multi-cell data
    //'--rna', // RNA seq datasets
    //'--metaviral', // metaviralSPAdes pipeline for virus detections
      '--rnaviral' // enables virus assembly module from RNA-Seq data
    ].join(' ')
    memory = 16.GB
    cpus = 8
    time = 12.h
  }
  withName: 'KRAKEN2_KRAKEN2' {
      publishDir = [ path: "${params.outdir}/kraken", mode: 'copy']
  }
}

trace {
    enabled = true
    file = "$params.outdir/trace.txt"
    overwrite = true
}

manifest {
    name = 'j23414/illumina-denovo-assemble'
    description = "A modular workflow for de novo assembling viral genomes from paired end illumina data before downstream analysis."
    version = "0.0"
    mainScript = 'main.nf'
}